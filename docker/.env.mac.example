# Mac Docker Desktop 专用（复制为 .env.mac 后修改）
SPRING_PROFILES_ACTIVE=dev
DOCKER_PLATFORM=linux/arm64
REGISTRY_PREFIX=
WEB_PORT=80

# 若 MySQL/Redis/Nacos/MinIO 已映射到 Mac 本机端口，保持 host.docker.internal 即可
NACOS_ADDR=host.docker.internal:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=hbbxl-test

MYSQL_JDBC=jdbc:mysql://host.docker.internal:3306/zytb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=root

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://host.docker.internal:9010
MINIO_PUBLIC_ENDPOINT=http://host.docker.internal:9010
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hbbxl

# 若希望用容器名直连（需先: docker network connect hbbxl-net <mysql容器名> 等），可改成例如:
# MYSQL_JDBC=jdbc:mysql://mysql:3306/zytb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# REDIS_HOST=redis
# NACOS_ADDR=nacos:8848
# MINIO_ENDPOINT=http://minio:9000
