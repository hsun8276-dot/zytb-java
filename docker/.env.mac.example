# Mac Docker Desktop = 生产（复制为 .env.mac）
# 容器名以 docker ps 为准（当前为 dz-mysql / dz-redis / dz-nacos / dz-minio）
#
#   docker network create hbbxl-net 2>/dev/null || true
#   docker network connect hbbxl-net dz-mysql
#   docker network connect hbbxl-net dz-redis
#   docker network connect hbbxl-net dz-nacos
#   docker network connect hbbxl-net dz-minio

SPRING_PROFILES_ACTIVE=prod
DOCKER_PLATFORM=linux/arm64
REGISTRY_PREFIX=
WEB_PORT=80

NACOS_ADDR=dz-nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=hbbxl

MYSQL_JDBC=jdbc:mysql://dz-mysql:3306/zytb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=root

REDIS_HOST=dz-redis
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=http://dz-minio:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hbbxl
