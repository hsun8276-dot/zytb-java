# Mac Docker Desktop = 生产（复制为 .env.mac）
# 容器: dz-mysql / dz-redis / dz-nacos / dz-minio 须已加入网络 hbbxl-net

SPRING_PROFILES_ACTIVE=prod
DOCKER_PLATFORM=linux/arm64
# 本地 load 镜像留空；GHCR 则: ghcr.io/hsun8276-dot/
REGISTRY_PREFIX=
WEB_PORT=80

NACOS_ADDR=dz-nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=hbbxl

MYSQL_HOST=dz-mysql
MYSQL_PORT=3306
MYSQL_JDBC=jdbc:mysql://dz-mysql:3306/zytb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=dz_root_2024

REDIS_HOST=dz-redis
REDIS_PORT=6379
REDIS_PASSWORD=dz_redis_2024

MINIO_HOST=dz-minio
MINIO_PORT=9000
MINIO_ENDPOINT=http://dz-minio:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hbbxl
