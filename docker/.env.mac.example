# Mac Docker Desktop = 生产（复制为 .env.mac）
# 中间件与业务容器必须在同一网络 hbbxl-net，用【容器名】互通（不要用 host.docker.internal）
#
# 先执行（容器名按你 Docker Desktop 里实际名字改）:
#   docker network create hbbxl-net 2>/dev/null || true
#   docker network connect hbbxl-net mysql
#   docker network connect hbbxl-net redis
#   docker network connect hbbxl-net nacos
#   docker network connect hbbxl-net minio
#
# 查看容器名: docker ps --format "{{.Names}}"

SPRING_PROFILES_ACTIVE=prod
DOCKER_PLATFORM=linux/arm64
REGISTRY_PREFIX=
WEB_PORT=80

# 下面主机名 = Docker 容器名（若你的 MySQL 叫 mysql-1，就把 mysql 改成 mysql-1）
NACOS_ADDR=nacos:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_NAMESPACE=hbbxl

MYSQL_JDBC=jdbc:mysql://mysql:3306/zytb?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USER=root
MYSQL_PASSWORD=root

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 容器内 API 端口一般是 9000；浏览器访问用 Mac 已映射端口（常见 9010）
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9010
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hbbxl
