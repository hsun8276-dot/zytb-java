# 后端服务通用镜像
#   docker build -f docker/Dockerfile.backend \
#     --build-arg JAR_FILE=hbbxl-auth/target/hbbxl-auth-1.0.0-SNAPSHOT.jar \
#     -t hbbxl/auth:latest .
FROM eclipse-temurin:17-jre

ARG JAR_FILE
ARG PORT=8800
ARG SPRING_PROFILES_ACTIVE=prod

# 安装 curl 供健康检查；JAVA_OPTS 可被外部覆盖，业务参数用 APP_OPTS 追加
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

ENV TZ=Asia/Shanghai \
    SPRING_PROFILES_ACTIVE=${SPRING_PROFILES_ACTIVE} \
    JAVA_OPTS="-Xms128m -Xmx256m -XX:+UseSerialGC -XX:MaxMetaspaceSize=256m -XX:MetaspaceSize=128m -Duser.timezone=Asia/Shanghai" \
    APP_OPTS=""

WORKDIR /app
COPY ${JAR_FILE} app.jar
EXPOSE ${PORT}

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS $APP_OPTS -jar app.jar"]
